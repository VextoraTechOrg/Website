# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vextora_chatbot
GEMINI_API_KEY=your_key_here
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=1536
CHAT_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024
RETRIEVAL_TOP_K=5
SIMILARITY_DISTANCE_CUTOFF=0.75
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
MAX_HISTORY_TURNS=6
CORS_ALLOW_ORIGINS=https://vextoratech.com,https://www.vextoratech.com,http://localhost:8080,http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
KNOWLEDGE_BASE_DIR=knowledge_base
